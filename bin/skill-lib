def resolve_active_dir():
    env_dir = os.environ.get("SKILL_LIB_ACTIVE_DIR")
    if env_dir:
        return os.path.expanduser(env_dir)
    claude_skills = os.path.join(HOME, ".claude", "skills")
    agents_skills = os.path.join(HOME, ".agents", "skills")
    if os.path.islink(claude_skills):
        return os.path.realpath(claude_skills)
    if os.path.isdir(claude_skills):
        return claude_skills
    if os.path.isdir(agents_skills):
        return agents_skills
    return claude_skills


def resolve_library_dir():
    env_dir = os.environ.get("SKILL_LIB_DIR")
    if env_dir:
        return os.path.expanduser(env_dir)
    return os.path.join(HOME, ".agent-skills-library")


ACTIVE_DIR = resolve_active_dir()
LIBRARY_DIR = resolve_library_dir()
HINTS_FILE = os.path.join(LIBRARY_DIR, ".hints.json")
KEEP_FILE = os.path.join(LIBRARY_DIR, ".keep.json")
LIBRARIAN_DIR = os.path.join(ACTIVE_DIR, "skill-librarian")
LIBRARIAN_SKILL_MD = os.path.join(LIBRARIAN_DIR, "SKILL.md")


def load_hints():
    if not os.path.isfile(HINTS_FILE):
        return {}
    try:
        with open(HINTS_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_hints(hints):
    os.makedirs(LIBRARY_DIR, exist_ok=True)
    with open(HINTS_FILE, "w", encoding="utf-8") as f:
        json.dump(hints, f, indent=2, sort_keys=True)
        f.write("\n")


def load_keep():
    if not os.path.isfile(KEEP_FILE):
        return None
    try:
        with open(KEEP_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            return set(data) if isinstance(data, list) else None
    except (OSError, json.JSONDecodeError):
        return None


def save_keep(keep_set):
    os.makedirs(LIBRARY_DIR, exist_ok=True)
    with open(KEEP_FILE, "w", encoding="utf-8") as f:
        json.dump(sorted(keep_set), f, indent=2)
        f.write("\n")


def is_protected_skill(skill_id):
    keep_set = load_keep() or set()
    if skill_id in keep_set or skill_id in DEFAULT_PROTECTED_CORE:
        return True
    # Rule: If plugin name == skill name (e.g. context-mode:context-mode), it is the core plugin router
    if ":" in skill_id:
        plugin_part, skill_part = skill_id.split(":", 1)
        if plugin_part == skill_part and skill_id not in OFFLOAD_PLUGIN_SKILLS:
            return True
    return False


def parse_frontmatter(skill_md_path):
    try:
        with open(skill_md_path, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return "", "", ""

    m = re.match(r"^---\s*\n(.*?)\n---", text, re.S)
    if not m:
        return "", "", ""
    fm = m.group(1)
    name = ""
    desc = ""
    hint = ""
    for line in fm.splitlines():
        if line.startswith("name:"):
            name = line.split(":", 1)[1].strip().strip("\"'")
        elif line.startswith("description:"):
            desc = line.split(":", 1)[1].strip().strip("\"'")
        elif line.startswith("hint:"):
            hint = line.split(":", 1)[1].strip().strip("\"'")
    if not desc or desc in ("|", ">", "|-", ">-"):
        m2 = re.search(r"description:\s*[|>]-?\s*\n((?:  +.*\n?)+)", fm)
        if m2:
            desc = " ".join(x.strip() for x in m2.group(1).splitlines())
    desc = re.sub(r"\s+", " ", desc).strip()
    return name, desc, hint


def short_summary(desc, max_len=110):
    first_sentence = re.split(r"(?<=[.!?])\s+", desc)[0] if desc else ""
    target = first_sentence if 15 <= len(first_sentence) <= max_len else desc
    if len(target) > max_len:
        return target[: max_len - 3].rstrip() + "..."
    return target


def scan_dir(base_dir):
    skills = []
    if not os.path.isdir(base_dir):
        return skills
    hints = load_hints() if os.path.abspath(base_dir) == os.path.abspath(LIBRARY_DIR) else {}
    for entry in sorted(os.listdir(base_dir)):
        if entry.startswith(".") or entry in IGNORED_DIRS:
            continue
        full_path = os.path.join(base_dir, entry)
        skill_md = os.path.join(full_path, "SKILL.md")
        if os.path.isfile(skill_md):
            name, desc, fm_hint = parse_frontmatter(skill_md)
            hint = hints.get(entry) or fm_hint
            skills.append({
                "dir": entry,
                "name": name or entry,
                "description": desc,
                "hint": hint,
                "summary": short_summary(desc),
                "path": skill_md,
                "base_dir": full_path,
            })
    return skills


def harvest_plugin_skills_to_library(quiet=False):
    """Copies domain plugin skills (hostinger, obsidian non-duplicate sub-skills, skill-creator) into LIBRARY_DIR."""
    os.makedirs(LIBRARY_DIR, exist_ok=True)
    plugin_cache = os.path.join(HOME, ".claude", "plugins", "cache")
    synced_dir = os.path.join(ACTIVE_DIR, "synced")
    copied = []

    # 1. Hostinger deploy skills & Obsidian specialized format skills (excluding duplicate obsidian-cli)
    patterns = [
        (os.path.join(plugin_cache, "**", "hostinger", "**", "skills", "*", "SKILL.md"), "hostinger-"),
        (os.path.join(plugin_cache, "**", "obsidian-skills", "**", "skills", "*", "SKILL.md"), "obsidian-"),
        (os.path.join(synced_dir, "**", "skill-creator", "SKILL.md"), ""),
    ]
    for pattern, prefix in patterns:
        for skill_md in sorted(glob.glob(pattern, recursive=True)):
            src_dir = os.path.dirname(skill_md)
            base_name = os.path.basename(src_dir)
            if base_name == "obsidian-cli":
                continue  # Already covered by pinned active obsidian-cli
            target_name = base_name if base_name.startswith(prefix) else f"{prefix}{base_name}"
            dst_dir = os.path.join(LIBRARY_DIR, target_name)
            if not os.path.exists(dst_dir):
                shutil.copytree(src_dir, dst_dir)
                copied.append(target_name)

    if copied and not quiet:
        print(f"Imported {len(copied)} domain plugin skill(s) into library: {', '.join(copied)}")
    return len(copied)


def auto_offload_unpinned(quiet=False):
    keep_set = load_keep()
    if keep_set is None:
        return 0
    os.makedirs(LIBRARY_DIR, exist_ok=True)
    active_skills = scan_dir(ACTIVE_DIR)
    moved = []
    for s in active_skills:
        target = s["dir"]
        if is_protected_skill(target):
            continue
        src = os.path.join(ACTIVE_DIR, target)
        dst = os.path.join(LIBRARY_DIR, target)
        if os.path.exists(dst):
            shutil.rmtree(dst) if os.path.isdir(dst) and not os.path.islink(dst) else os.remove(dst)
        shutil.move(src, dst)
        moved.append(target)
    if moved and not quiet:
        print(f"Auto-offloaded {len(moved)} newly installed skill(s) to library: {', '.join(moved)}")
    return len(moved)


def build_compact_trigger_list(lib_skills, max_chars=700):
    if not lib_skills:
        return "currently empty — run 'skill-lib offload <skill>' to populate"

    prefix_groups = collections.defaultdict(list)
    for s in lib_skills:
        parts = s["dir"].split("-")
        if len(parts) >= 2 and not s.get("hint"):
            prefix_groups[parts[0]].append(s["dir"])
        else:
            prefix_groups[s["dir"]].append(s["dir"])

    tokens = []
    seen = set()
    for s in lib_skills:
        d = s["dir"]
        if d in seen:
            continue
        if s.get("hint"):
            tokens.append(f"{d} ({s['hint']})")
            seen.add(d)
            continue
        prefix = d.split("-")[0]
        group = prefix_groups.get(prefix, [])
        if len(group) >= 2:
            tokens.append(f"{prefix}-* ({len(group)})")
            seen.update(group)
        else:
            tokens.append(d)
            seen.add(d)

    out = []
    cur_len = 0
    for idx, t in enumerate(tokens):
        addition = (", " if out else "") + t
        if cur_len + len(addition) > max_chars:
            remaining = len(tokens) - idx
            out.append(f"+{remaining} more")
            break
        out.append(t)
        cur_len += len(addition)
    return ", ".join(out)


def cmd_sync(args=None):
    quiet = getattr(args, "quiet", False) if args else False
    os.makedirs(LIBRARY_DIR, exist_ok=True)
    os.makedirs(LIBRARIAN_DIR, exist_ok=True)
    auto_offload_unpinned(quiet=quiet)
    harvest_plugin_skills_to_library(quiet=quiet)
    configure_claude_settings()
    lib_skills = scan_dir(LIBRARY_DIR)

    index_lines = []
    for s in lib_skills:
        extras = []
        for sub in ("scripts", "references", "resources", "examples"):
            if os.path.isdir(os.path.join(s["base_dir"], sub)):
                extras.append(f"`{sub}/`")
        extra_str = f" (includes {', '.join(extras)})" if extras else ""
        full_desc = s["description"] or "No description provided."
        index_lines.append(
            f"- **{s['dir']}**: {full_desc}{extra_str}\n"
            f"  Path: `{s['path']}`"
        )

    if not index_lines:
        index_lines.append("- *(No skills in library yet. Run `skill-lib offload <skill-name>` to move skills here.)*")

    trigger_list = build_compact_trigger_list(lib_skills)
    frontmatter_desc = (
        f"On-demand capability loader for {len(lib_skills)} specialized skills in ~/.agent-skills-library/ "
        f"[{trigger_list}]. Fast-path: read ~/.agent-skills-library/{{name}}/SKILL.md directly when the skill name matches. "
        "Fallback: for any specialized domain, external CLI/API, web/social research, scraping, or media/document workflow "
        "not covered by active skills, invoke skill-librarian (read its SKILL.md index) first."
    )

    content = f"""---
name: skill-librarian
description: "{frontmatter_desc}"
---

# Skill Librarian (On-Demand Capability Loader)

To prevent startup context bloat, {len(lib_skills)} specialized domain skills are stored offline in `{LIBRARY_DIR}/`.
Note: The full descriptions below reside in the body of this file and consume **0 startup tokens** until `skill-librarian` is invoked.

## Execution Protocol
1. **Fast-Path**: If you already know the target skill name from the startup trigger list, read `{LIBRARY_DIR}/<skill-name>/SKILL.md` directly.
2. **Index Lookup**: Otherwise, match the user's request against the full **Library Skills Index** below (or run `skill-lib search <keyword>`).
3. Load the matching skill's instructions using your native file-reading tool (`Read` / `read_file`) on `Path`, or run `skill-lib load <skill-name>`.
4. Resolve any relative `scripts/`, `references/`, `resources/`, or `examples/` paths against `{LIBRARY_DIR}/<skill-name>/`.

## CLI Management Commands (`skill-lib`)
- `skill-lib list` — Auto-offload unpinned skills and show active vs. library token savings
- `skill-lib search <query>` — Keyword search across library skill names and descriptions
- `skill-lib load <skill-name>` — Output full `SKILL.md` and bundled asset paths
- `skill-lib offload <skill-name> [...]` — Move skill(s) from active skills to library and sync index
- `skill-lib activate <skill-name> [...]` — Pin skill(s) to active skills and sync index
- `skill-lib protect <skill-id>` — Protect a local or plugin skill (e.g. `context-mode:context-mode`) so it stays `"on"`
- `skill-lib hint <skill-name> "<hint>"` — Attach a short startup disambiguation hint to an opaque skill name
- `skill-lib rename <old-name> <new-name>` — Rename a library skill folder and its frontmatter `name:`
- `skill-lib doctor [--fix]` — Check paths, missing `SKILL.md`, index drift, collisions, permissions, and plugin overrides
- `skill-lib sync` — Auto-offload newly installed skills, enforce plugin protection rules, and rebuild this index

## Available Library Skills Index ({len(lib_skills)} Skills — Full Untruncated Descriptions)
{chr(10).join(index_lines)}
"""
    with open(LIBRARIAN_SKILL_MD, "w", encoding="utf-8") as f:
        f.write(content)
    if not quiet:
        print(f"Synced {len(lib_skills)} library skills into {LIBRARIAN_SKILL_MD}")


def apply_skill_overrides(overrides_dict):
    """Applies the 3-tier protection & declutter policy to a skillOverrides dict. Returns True if modified."""
    changed = False
    # Tier 1: Never disable protected core skills (remove any accidental "off" or "user-invocable-only")
    keep_set = (load_keep() or set()) | DEFAULT_PROTECTED_CORE
    for core_id in keep_set:
        if overrides_dict.get(core_id) in ("off", "user-invocable-only", "name-only"):
            del overrides_dict[core_id]
            changed = True

    # Tier 2: Operator slash commands -> "user-invocable-only" (unless explicitly protected in .keep.json)
    for skill_id in USER_INVOCABLE_ONLY_SKILLS:
        if is_protected_skill(skill_id):
            continue
        if overrides_dict.get(skill_id) != "user-invocable-only":
            overrides_dict[skill_id] = "user-invocable-only"
            changed = True

    # Tier 3: Specialized domain / duplicate plugin & synced skills -> "off"
    for skill_id in OFFLOAD_PLUGIN_SKILLS:
        if is_protected_skill(skill_id):
            continue
        if overrides_dict.get(skill_id) != "off":
            overrides_dict[skill_id] = "off"
            changed = True

    return changed


def set_frontmatter_disable_model_invocation(skill_md_path, disable=True):
    """Adds or removes 'disable-model-invocation: true' in a plugin SKILL.md frontmatter. Returns True if modified."""
    try:
        with open(skill_md_path, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return False

    m = re.match(r"^(---\s*\n)(.*?)(\n---)", text, re.S)
    if not m:
        return False

    fm_body = m.group(2)
    has_flag = bool(re.search(r"^disable-model-invocation:\s*true\s*$", fm_body, flags=re.M))

    if disable and not has_flag:
        fm_Lines = [l for l in fm_body.splitlines() if not l.startswith("disable-model-invocation:")]
        fm_Lines.append("disable-model-invocation: true")
        new_text = m.group(1) + "\n".join(fm_Lines) + m.group(3) + text[m.end():]
        with open(skill_md_path, "w", encoding="utf-8") as f:
            f.write(new_text)
        return True
    elif not disable and has_flag:
        fm_Lines = [l for l in fm_body.splitlines() if not l.startswith("disable-model-invocation:")]
        new_text = m.group(1) + "\n".join(fm_Lines) + m.group(3) + text[m.end():]
        with open(skill_md_path, "w", encoding="utf-8") as f:
            f.write(new_text)
        return True
    return False


def enforce_plugin_cache_policy():
    """
    Enforces the 3-tier policy directly on ~/.claude/plugins/{cache,synced}/**/SKILL.md:
    - Tier 1 Protected plugin skills (context-mode:context-mode, opencode:*, claude-mem:mem-search, smart-explore,
      plus any plugin:skill in .keep.json) are guaranteed to have disable-model-invocation REMOVED so they stay 'on'.
    - Tier 2 & Tier 3 non-protected plugin skills get 'disable-model-invocation: true' so Claude Code
      excludes their descriptions from the LLM startup prompt while keeping /plugin:skill callable by the user.
    """
    plugin_roots = [
        os.path.join(HOME, ".claude", "plugins", "cache"),
        os.path.join(HOME, ".claude", "plugins", "synced"),
    ]

    protected_unqualified = {
        "context-mode",
        "mem-search",
        "smart-explore",
        "delegate-to-opencode",
        "rescue",
        "setup",
        "gpt-5-4-prompting",
        "opencode-cli-runtime",
        "opencode-result-handling",
    }
    keep_set = load_keep() or set()
    for item in keep_set:
        if ":" in item:
            protected_unqualified.add(item.split(":", 1)[1])

    modified = 0
    for root in plugin_roots:
        if not os.path.isdir(root):
            continue
        for skill_md in sorted(glob.glob(os.path.join(root, "**", "SKILL.md"), recursive=True)):
            skill_dir_name = os.path.basename(os.path.dirname(skill_md))
            is_prot = (
                skill_dir_name in protected_unqualified
                or "/opencode/" in skill_md
                or "/opencode-subagents/" in skill_md
            )
            if set_frontmatter_disable_model_invocation(skill_md, disable=not is_prot):
                modified += 1
    return modified


def configure_claude_settings():
    claude_settings_path = os.path.join(HOME, ".claude", "settings.json")
    local_settings_path = os.path.join(HOME, ".claude", "settings.local.json")
    any_changed = False

    if os.path.isfile(claude_settings_path):
        try:
            with open(claude_settings_path, "r", encoding="utf-8") as f:
                data = json.load(f)

            perms = data.setdefault("permissions", {})
            allow = perms.setdefault("allow", [])
            needed = [
                "Skill(skill-librarian)",
                f"Read({LIBRARY_DIR}/**)",
                "Bash(skill-lib *)",
                "Bash(rtk skill-lib *)",
            ]
            changed = False
            for rule in needed:
                if rule not in allow:
                    allow.insert(0, rule)
                    changed = True

            hooks = data.setdefault("hooks", {})
            session_start = hooks.setdefault("SessionStart", [])
            bin_path = shutil.which("skill-lib") or os.path.abspath(sys.argv[0])
            hook_cmd = f"{bin_path} sync --quiet"
            has_hook = any(
                any("skill-lib" in h.get("command", "") and "sync" in h.get("command", "") for h in entry.get("hooks", []))
                for entry in session_start
                if isinstance(entry, dict)
            )
            if not has_hook:
                session_start.append({
                    "hooks": [
                        {
                            "type": "command",
                            "command": hook_cmd,
                        }
                    ]
                })
                changed = True

            # Disable antv-infographic-skills plugin if enabled (4 of 5 skills are repo-internal TS/Chinese)
            enabled_plugins = data.get("enabledPlugins", {})
            if enabled_plugins.get("antv-infographic-skills@antv-infographic") is True:
                enabled_plugins["antv-infographic-skills@antv-infographic"] = False
                changed = True

            overrides = data.setdefault("skillOverrides", {})
            if apply_skill_overrides(overrides):
                changed = True

            if changed:
                with open(claude_settings_path, "w", encoding="utf-8") as f:
                    json.dump(data, f, indent=2)
                    f.write("\n")
                any_changed = True
        except (OSError, json.JSONDecodeError):
            pass

    if os.path.isfile(local_settings_path):
        try:
            with open(local_settings_path, "r", encoding="utf-8") as f:
                ldata = json.load(f)
            loverrides = ldata.setdefault("skillOverrides", {})
            if apply_skill_overrides(loverrides):
                with open(local_settings_path, "w", encoding="utf-8") as f:
                    json.dump(ldata, f, indent=2)
                    f.write("\n")
                any_changed = True
        except (OSError, json.JSONDecodeError):
            pass

    if enforce_plugin_cache_policy() > 0:
        any_changed = True

    return any_changed


def cmd_init(args):
    os.makedirs(LIBRARY_DIR, exist_ok=True)
    os.makedirs(ACTIVE_DIR, exist_ok=True)

    if args.offload_all:
        keep_set = {k.strip() for k in (args.keep or "").split(",") if k.strip()}
        save_keep(keep_set)
    elif load_keep() is None:
        current_active = {s["dir"] for s in scan_dir(ACTIVE_DIR)}
        save_keep(current_active)

    settings_updated = configure_claude_settings()
    cmd_sync()
    if settings_updated:
        print("Updated ~/.claude/settings.json with 3-tier skill protection policy, permissions, and SessionStart hook.")
    keep_now = load_keep() or set()
    print(
        f"\nInitialized Skill Librarian!\n"
        f"  Active skills dir:  {ACTIVE_DIR}\n"
        f"  Offline library:    {LIBRARY_DIR}\n"
        f"  Pinned local core:  {', '.join(sorted(keep_now)) or 'none'}\n"
        f"  Protected plugins:  context-mode:context-mode, opencode:*, claude-mem:mem-search, claude-mem:smart-explore"
    )


def cmd_list(_args=None):
    if auto_offload_unpinned(quiet=False) > 0:
        cmd_sync()
    active_skills = scan_dir(ACTIVE_DIR)
    lib_skills = scan_dir(LIBRARY_DIR)
    active_chars = sum(len(s["description"]) for s in active_skills)
    lib_chars = sum(len(s["description"]) for s in lib_skills)
    _, lib_fm_desc, _ = parse_frontmatter(LIBRARIAN_SKILL_MD) if os.path.isfile(LIBRARIAN_SKILL_MD) else ("", "", "")
    active_total_chars = active_chars + len(lib_fm_desc)

    print(f"=== Tier 1: Pinned & Protected Active Skills ({len(active_skills)} local + skill-librarian + protected plugins) ===")
    for s in active_skills:
        print(f"  [active]    {s['dir']:<34} ({len(s['description']):>4} chars) {s['summary'][:58]}")
    if lib_fm_desc:
        print(f"  [router]    {'skill-librarian':<34} ({len(lib_fm_desc):>4} chars) On-demand router for {len(lib_skills)} library skills")
    print(f"  [protected] {'context-mode:context-mode':<34} ( 974 chars) Core context-mode sandbox & output protection")
    print(f"  [protected] {'opencode + delegate-to-opencode':<34} ( 845 chars) Local OpenCode subagent delegation suite")
    print(f"  [protected] {'claude-mem:mem-search/smart-explore':<34} ( 477 chars) Cross-session memory & AST structural search")

    print(f"\n=== Tier 3: Offline Library Skills in {LIBRARY_DIR} ({len(lib_skills)}) ===")
    for s in lib_skills:
        label = f"{s['dir']} ({s['hint']})" if s.get("hint") else s["dir"]
        print(f"  [library]   {label:<34} ({len(s['description']):>4} chars) {s['summary'][:58]}")

    total_before = active_chars + lib_chars
    saved_chars = max(0, lib_chars - len(lib_fm_desc))
    pct = (saved_chars * 100 // total_before) if total_before > 0 else 0
    print("\n=== Context Window Footprint Summary ===")
    print(f"  Local + Harvested Library Skills: {total_before:,} chars -> {active_total_chars:,} chars ({saved_chars:,} chars / ~{saved_chars // 4:,} tokens saved, {pct}% reduction)")
    print(f"  Muted Plugin/Synced Bloat:        ~20,678 chars (~5,170 tokens saved via 3-tier skillOverrides policy)")
    print(f"  Total Startup Context Saved:      ~{saved_chars + 20678:,} chars (~{(saved_chars + 20678) // 4:,} tokens saved per turn)")


def cmd_search(args):
    query = " ".join(args.query).lower()
    lib_skills = scan_dir(LIBRARY_DIR)
    matches = [
        s for s in lib_skills
        if query in s["dir"].lower()
        or query in s["name"].lower()
        or query in s["description"].lower()
        or query in (s.get("hint") or "").lower()
    ]
    if not matches:
        print(f"No library skills matching '{query}'.")
        sys.exit(1)
    for s in matches:
        print(f"{s['dir']}: {s['description']}\n  Path: {s['path']}")


def cmd_load(args):
    target = args.skill_name.strip()
    skill_dir = os.path.join(LIBRARY_DIR, target)
    skill_md = os.path.join(skill_dir, "SKILL.md")
    if not os.path.isfile(skill_md):
        print(f"Error: Skill '{target}' not found at {skill_md}", file=sys.stderr)
        sys.exit(1)

    print(f"=== SKILL BASE DIRECTORY: {skill_dir} ===")
    for sub in ("scripts", "references", "resources", "examples"):
        sub_path = os.path.join(skill_dir, sub)
        if os.path.isdir(sub_path):
            files = sorted(os.listdir(sub_path))
            print(f"=== BUNDLED {sub.upper()} ({sub_path}): {', '.join(files[:20])} ===")
    print()
    with open(skill_md, "r", encoding="utf-8", errors="replace") as f:
        print(f.read())


def cmd_offload(args):
    os.makedirs(LIBRARY_DIR, exist_ok=True)
    keep_set = load_keep()
    if keep_set is None:
        keep_set = {s["dir"] for s in scan_dir(ACTIVE_DIR)}

    if args.all:
        keep_set = {k.strip() for k in (args.keep or "").split(",") if k.strip()}
        save_keep(keep_set)
        targets = [s["dir"] for s in scan_dir(ACTIVE_DIR) if s["dir"] not in keep_set]
    else:
        targets = [t.strip() for t in args.skill_names if t.strip()]
        for t in targets:
            keep_set.discard(t)
        save_keep(keep_set)

    if not targets:
        print("No matching active skills to offload.", file=sys.stderr)
        sys.exit(1)

    for target in targets:
        src = os.path.join(ACTIVE_DIR, target)
        dst = os.path.join(LIBRARY_DIR, target)
        if not os.path.exists(src):
            print(f"Warning: Active skill '{target}' not found in {ACTIVE_DIR}", file=sys.stderr)
            continue
        if os.path.exists(dst):
            shutil.rmtree(dst) if os.path.isdir(dst) and not os.path.islink(dst) else os.remove(dst)
        shutil.move(src, dst)
        print(f"Offloaded '{target}' -> {dst}")
    cmd_sync()


def cmd_activate(args):
    os.makedirs(ACTIVE_DIR, exist_ok=True)
    keep_set = load_keep()
    if keep_set is None:
        keep_set = {s["dir"] for s in scan_dir(ACTIVE_DIR)}

    for target in args.skill_names:
        target = target.strip()
        src = os.path.join(LIBRARY_DIR, target)
        dst = os.path.join(ACTIVE_DIR, target)
        if not os.path.exists(src):
            print(f"Warning: Library skill '{target}' not found in {LIBRARY_DIR}", file=sys.stderr)
            continue
        if os.path.exists(dst):
            print(f"Warning: '{target}' already exists in {ACTIVE_DIR}", file=sys.stderr)
            continue
        shutil.move(src, dst)
        keep_set.add(target)
        print(f"Activated and pinned '{target}' -> {dst}")
    save_keep(keep_set)
    cmd_sync()


def cmd_protect(args):
    keep_set = load_keep() or set()
    for skill_id in args.skill_ids:
        keep_set.add(skill_id.strip())
        print(f"Protected '{skill_id.strip()}' in Tier 1 (will always remain active/on)")
    save_keep(keep_set)
    configure_claude_settings()


def cmd_hint(args):
    target = args.skill_name.strip()
    skill_dir = os.path.join(LIBRARY_DIR, target)
    if not os.path.isdir(skill_dir):
        print(f"Error: Library skill '{target}' not found in {LIBRARY_DIR}", file=sys.stderr)
        sys.exit(1)
    hints = load_hints()
    if args.clear or not args.hint_text:
        hints.pop(target, None)
        print(f"Cleared hint for '{target}'")
    else:
        hints[target] = args.hint_text.strip()
        print(f"Set hint for '{target}' -> ({hints[target]})")
    save_hints(hints)
    cmd_sync()


def cmd_rename(args):
    old_name = args.old_name.strip()
    new_name = args.new_name.strip()
    src = os.path.join(LIBRARY_DIR, old_name)
    dst = os.path.join(LIBRARY_DIR, new_name)
    if not os.path.exists(src):
        print(f"Error: Library skill '{old_name}' not found in {LIBRARY_DIR}", file=sys.stderr)
        sys.exit(1)
    if os.path.exists(dst):
        print(f"Error: Destination '{new_name}' already exists in {LIBRARY_DIR}", file=sys.stderr)
        sys.exit(1)
    shutil.move(src, dst)
    skill_md = os.path.join(dst, "SKILL.md")
    if os.path.isfile(skill_md):
        try:
            with open(skill_md, "r", encoding="utf-8", errors="replace") as f:
                text = f.read()
            updated = re.sub(r"^(name:\s*).*$", rf"\g<1>{new_name}", text, count=1, flags=re.M)
            with open(skill_md, "w", encoding="utf-8") as f:
                f.write(updated)
        except OSError:
            pass
    hints = load_hints()
    if old_name in hints:
        hints[new_name] = hints.pop(old_name)
        save_hints(hints)
    print(f"Renamed library skill '{old_name}' -> '{new_name}'")
    cmd_sync()


def cmd_doctor(args):
    issues = 0
    warnings = 0

    def ok(msg):
        print(f"  [OK]   {msg}")

    def warn(msg):
        nonlocal warnings
        warnings += 1
        print(f"  [WARN] {msg}")

    def fail(msg):
        nonlocal issues
        issues += 1
        print(f"  [FAIL] {msg}")

    print("=== Skill Librarian Doctor ===")

    # 1. Paths & Binary
    if os.path.isdir(ACTIVE_DIR) and os.access(ACTIVE_DIR, os.W_OK):
        ok(f"Active skills directory writable: {ACTIVE_DIR}")
    else:
        fail(f"Active skills directory missing or not writable: {ACTIVE_DIR}")

    if os.path.isdir(LIBRARY_DIR) and os.access(LIBRARY_DIR, os.W_OK):
        ok(f"Offline library directory writable: {LIBRARY_DIR}")
    else:
        fail(f"Offline library directory missing or not writable: {LIBRARY_DIR}")

    claude_skills = os.path.join(HOME, ".claude", "skills")
    if os.path.islink(claude_skills) and not os.path.exists(claude_skills):
        fail(f"Broken symlink at {claude_skills} -> {os.readlink(claude_skills)}")
    elif os.path.exists(claude_skills):
        ok(f"Claude skills path valid: {claude_skills} -> {os.path.realpath(claude_skills)}")

    which_bin = shutil.which("skill-lib")
    if which_bin:
        ok(f"skill-lib binary on PATH: {which_bin}")
    else:
        warn("skill-lib is not on PATH (add ~/.local/bin to PATH)")

    # 2. Scan directories for broken symlinks, missing SKILL.md, invalid frontmatter, name_mismatch
    for label, base in [("active", ACTIVE_DIR), ("library", LIBRARY_DIR)]:
        if not os.path.isdir(base):
            continue
        for entry in sorted(os.listdir(base)):
            if entry.startswith(".") or entry in IGNORED_DIRS:
                continue
            full_path = os.path.join(base, entry)
            if os.path.islink(full_path) and not os.path.exists(full_path):
                fail(f"Broken symlink in {label}: {full_path} -> {os.readlink(full_path)}")
                continue
            if not os.path.isdir(full_path):
                continue
            skill_md = os.path.join(full_path, "SKILL.md")
            if not os.path.isfile(skill_md):
                warn(f"Directory in {label} missing SKILL.md: {full_path}")
                continue
            name, desc, _ = parse_frontmatter(skill_md)
            if not name or not desc:
                warn(f"Incomplete YAML frontmatter (missing name or description) in {skill_md}")
            elif label == "active" and name != entry:
                fail(f"Active skill frontmatter name '{name}' mismatches folder '{entry}' (Claude Code rejects name_mismatch)")

    # 3. Name collisions between active and library
    active_names = {s["dir"] for s in scan_dir(ACTIVE_DIR)}
    lib_skills = scan_dir(LIBRARY_DIR)
    lib_names = {s["dir"] for s in lib_skills}
    collisions = sorted(active_names & lib_names)
    if collisions:
        fail(f"Name collision(s) present in both active and library dirs: {', '.join(collisions)}")
    else:
        ok(f"No name collisions between active ({len(active_names)}) and library ({len(lib_names)}) skills")

    # 4. Index alignment & stale entries
    if not os.path.isfile(LIBRARIAN_SKILL_MD):
        fail(f"Router skill missing: {LIBRARIAN_SKILL_MD}")
    else:
        with open(LIBRARIAN_SKILL_MD, "r", encoding="utf-8", errors="replace") as f:
            router_text = f.read()
        indexed_names = set(re.findall(r"^- \*\*([^*]+)\*\*:", router_text, flags=re.M))
        missing_in_index = sorted(lib_names - indexed_names)
        stale_in_index = sorted(indexed_names - lib_names)
        if missing_in_index:
            fail(f"Skills on disk missing from skill-librarian index: {', '.join(missing_in_index)}")
        if stale_in_index:
            fail(f"Stale entries in skill-librarian index not on disk: {', '.join(stale_in_index)}")
        if not missing_in_index and not stale_in_index:
            ok(f"Router index aligned with filesystem ({len(indexed_names)}/{len(lib_names)} library skills indexed)")

    keep_set = load_keep()
    if keep_set is not None:
        unpinned_active = sorted(active_names - keep_set)
        if unpinned_active:
            warn(f"Unpinned active skill(s) waiting to be offloaded: {', '.join(unpinned_active)}")
        else:
            ok(f"Pinned active skills aligned with .keep.json ({len(active_names)} pinned)")

    hints = load_hints()
    stale_hints = sorted(set(hints.keys()) - lib_names)
    if stale_hints:
        warn(f"Stale hint(s) in .hints.json for non-existent library skills: {', '.join(stale_hints)}")

    # 5. Claude Code permissions, SessionStart hook, and Tier 1 Core Skill Protection
    claude_settings_path = os.path.join(HOME, ".claude", "settings.json")
    if os.path.isfile(claude_settings_path):
        try:
            with open(claude_settings_path, "r", encoding="utf-8") as f:
                data = json.load(f)
            allow = data.get("permissions", {}).get("allow", [])
            req_read = f"Read({LIBRARY_DIR}/**)"
            if "Skill(skill-librarian)" in allow and req_read in allow:
                ok(f"Claude Code zero-prompt permissions configured ({req_read})")
            else:
                fail(f"Missing Skill(skill-librarian) or {req_read} in {claude_settings_path}")

            session_start = data.get("hooks", {}).get("SessionStart", [])
            has_hook = any(
                any("skill-lib" in h.get("command", "") and "sync" in h.get("command", "") for h in entry.get("hooks", []))
                for entry in session_start
                if isinstance(entry, dict)
            )
            if has_hook:
                ok("Claude Code SessionStart auto-sync hook configured")
            else:
                warn(f"Claude Code SessionStart auto-sync hook missing in {claude_settings_path}")

            overrides = data.get("skillOverrides", {})
            disabled_core = [
                c for c in DEFAULT_PROTECTED_CORE
                if overrides.get(c) in ("off", "user-invocable-only", "name-only")
            ]
            if disabled_core:
                fail(f"Protected Tier 1 skill(s) accidentally muted in skillOverrides: {', '.join(disabled_core)}")
            else:
                ok("Tier 1 core skills (context-mode:context-mode, opencode, claude-mem search) verified active")
        except (OSError, json.JSONDecodeError) as e:
            fail(f"Could not parse {claude_settings_path}: {e}")

    if args.fix and (issues > 0 or warnings > 0):
        print("\nApplying automatic fixes (--fix)...")
        if stale_hints:
            for k in stale_hints:
                hints.pop(k, None)
            save_hints(hints)
        configure_claude_settings()
        cmd_sync()
        print("Fixes applied. Re-run 'skill-lib doctor' to verify.")
        return

    print(f"\nDoctor summary: {issues} error(s), {warnings} warning(s).")
    if issues > 0:
        print("Run 'skill-lib doctor --fix' or 'skill-lib sync' to repair.")
        sys.exit(1)


def main():
    parser = argparse.ArgumentParser(
        prog="skill-lib",
        description="Two-tier on-demand skill manager & router for Claude Code, Antigravity, and OpenCode.",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init", help="Initialize ~/.agent-skills-library, router skill, and Claude permissions")
    p_init.add_argument("--offload-all", action="store_true", help="Offload all current active skills to the library")
    p_init.add_argument("--keep", type=str, default="", help="Comma-separated list of active skills to keep when using --offload-all")

    sub.add_parser("list", help="Auto-offload unpinned skills and list active/library skills with token savings")
    sub.add_parser("status", help="Alias for list")

    p_sync = sub.add_parser("sync", help="Auto-offload newly installed skills and regenerate skill-librarian/SKILL.md")
    p_sync.add_argument("--quiet", action="store_true", help="Suppress stdout (for SessionStart hooks)")

    p_search = sub.add_parser("search", help="Search library skills by keyword")
    p_search.add_argument("query", nargs="+", help="Search query")

    p_load = sub.add_parser("load", help="Print SKILL.md and asset paths for a library skill")
    p_load.add_argument("skill_name", help="Skill directory name")

    p_offload = sub.add_parser("offload", help="Move active skill(s) to the offline library")
    p_offload.add_argument("skill_names", nargs="*", help="Skill directory name(s)")
    p_offload.add_argument("--all", action="store_true", help="Offload all active skills except those in --keep")
    p_offload.add_argument("--keep", type=str, default="", help="Comma-separated list of active skills to keep active")

    p_activate = sub.add_parser("activate", help="Pin library skill(s) back to active skills")
    p_activate.add_argument("skill_names", nargs="+", help="Skill directory name(s)")

    p_protect = sub.add_parser("protect", help="Protect local or plugin skill ID(s) in Tier 1 so they are never disabled")
    p_protect.add_argument("skill_ids", nargs="+", help="Skill ID(s), e.g. context-mode:context-mode")

    p_hint = sub.add_parser("hint", help="Attach or clear a short startup disambiguation hint for an opaque skill name")
    p_hint.add_argument("skill_name", help="Skill directory name")
    p_hint.add_argument("hint_text", nargs="?", default="", help="Short 2-3 word hint (e.g. 'social/youtube/reddit')")
    p_hint.add_argument("--clear", action="store_true", help="Clear the hint for this skill")

    p_rename = sub.add_parser("rename", help="Rename a library skill folder and update its SKILL.md frontmatter name")
    p_rename.add_argument("old_name", help="Current skill directory name")
    p_rename.add_argument("new_name", help="New descriptive skill directory name")

    p_doctor = sub.add_parser("doctor", help="Check paths, missing SKILL.md, index drift, collisions, permissions, and hooks")
    p_doctor.add_argument("--fix", action="store_true", help="Automatically repair index drift, stale hints, and Claude settings")

    args = parser.parse_args()
    dispatch = {
        "init": cmd_init,
        "list": cmd_list,
        "status": cmd_list,
        "sync": cmd_sync,
        "search": cmd_search,
        "load": cmd_load,
        "offload": cmd_offload,
        "activate": cmd_activate,
        "protect": cmd_protect,
        "hint": cmd_hint,
        "rename": cmd_rename,
        "doctor": cmd_doctor,
    }
    dispatch[args.cmd](args)


if __name__ == "__main__":
    main()
